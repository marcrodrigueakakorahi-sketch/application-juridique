# Paiement Mobile Money via CinetPay.
# Sans CINETPAY_APIKEY et CINETPAY_SITE_ID, l'application reste en « mode démonstration » (paiement simulé).
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
# Clé secrète d'au moins 32 caractères qui signe les reçus de paiement. Ne la partagez jamais.
# Générez-en une avec : openssl rand -base64 32
PAIEMENT_SECRET=
# Moyens de paiement proposés : MOBILE_MONEY (par défaut), ALL, CREDIT_CARD, WALLET
CINETPAY_CHANNELS=MOBILE_MONEY
# Adresse publique du site (facultatif, déduite automatiquement sinon)
SITE_URL=
